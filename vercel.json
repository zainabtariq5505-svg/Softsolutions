{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/server/index.js",
      "maxDuration": 120
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index?__ss_path=/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/crm-reminders",
      "schedule": "0 4 * * *"
    }
  ]
}
